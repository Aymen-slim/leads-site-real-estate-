# Supabase (Settings -> API in Supabase Dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb-secret-key

# Single-admin dashboard auth (generate a 32+ char random secret)
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters-for-hmac

# Google Analytics 4 (optional; only loaded after visitor grants analytics consent)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
